#!/usr/bin/env bash
# forge -- the entry point. Forge is a generic service that points at a target project repo at runtime,
# defaulting to the sibling directory example-project.
# It loads forge.env first -- which holds FORGE_PROJECT_ROOT and the IM webhook, and is gitignored as
# private -- and only then runs.
#
# Where forge.env lives has to agree with ENV_FILE on the TypeScript side (configFile in src/root.ts), or
# "the config moved to FORGE_HOME but the CLI is still reading the old env in the checkout" silently runs
# against the wrong project.
# Note that FORGE_HOME and FORGE_CONFIG_DIR themselves **cannot** be set inside forge.env: they are what
# decides where to look for forge.env in the first place, so it is a chicken and egg. They have to come from
# the real environment -- the shell, or the launchd plist.
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"

config_dir() {
  if [ -n "${FORGE_CONFIG_DIR:-}" ]; then printf '%s\n' "$FORGE_CONFIG_DIR"; return; fi
  if [ -n "${FORGE_HOME:-}" ]; then printf '%s\n' "$FORGE_HOME/config"; return; fi
  printf '%s\n' "$HERE/config"
}

ENV_FILE="$(config_dir)/forge.env"
# It falls back one file at a time, by the same rule as configFile: if the overlay has no forge.env, use the
# one in the checkout.
[ -f "$ENV_FILE" ] || ENV_FILE="$HERE/config/forge.env"
if [ -f "$ENV_FILE" ]; then
  # Setting those two variables inside forge.env is already too late to affect where forge.env is looked for,
  # yet the TypeScript side would still honour them -- so the shell reads one env while Node looks for its
  # config somewhere else. Rather than let that happen silently, say so loudly.
  if grep -qE '^[[:space:]]*(FORGE_HOME|FORGE_CONFIG_DIR)=' "$ENV_FILE"; then
    echo "forge: $ENV_FILE defines FORGE_HOME or FORGE_CONFIG_DIR -- but those decide where this file is" >&2
    echo "       looked for, so setting them here comes too late and leaves the shell and Node using" >&2
    echo "       different config directories. Set them in the shell or launchd environment instead." >&2
  fi
  set -a
  # shellcheck source=/dev/null
  . "$ENV_FILE"
  set +a
fi

exec node --no-warnings "$HERE/src/index.ts" "$@"
