#!/bin/zsh
# Forge -- the daemon launcher, called by launchd's KeepAlive: it stays resident running forge listen (the IM
# long connection, the periodic tick, and the local status page).
# The plist points straight at this script rather than /bin/zsh, so macOS's Login Items and Extensions pane
# shows forge-daemon rather than zsh.
# It locates the repo root itself and extends PATH -- launchd's environment is minimal and carries no path to
# node, claude, codex or gh.
set -e
DIR="${0:A:h}"          # the directory this script lives in = <repo>/deploy
SVC="${DIR:h}"          # the repo root
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$HOME/.bun/bin:$HOME/.local/bin:$PATH"
cd "$SVC" || exit 1
mkdir -p logs
echo "---- Forge listen starting @ $(date '+%Y-%m-%d %H:%M:%S') ----" >> logs/launchd.log
# caffeinate -is stops the system sleeping, idle sleep included, while the daemon runs, so the Mac keeps
# responding for as long as it is awake.
# Note that closing the lid still sleeps it, at the system level; on waking, backfill collects the channel
# messages from the offline window so no requirement is lost.
exec caffeinate -is ./forge listen >> logs/launchd.log 2>&1
