#!/bin/zsh
# Forge -- the watchdog launcher, called by launchd's StartInterval every 60s: it runs forge watchdog once
# (liveness probe, self-healing and alerting) and exits.
# The plist points straight at this script, so macOS background activity shows forge-watchdog rather than zsh.
set -e
DIR="${0:A:h}"          # <repo>/deploy
SVC="${DIR:h}"          # the repo root
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$HOME/.bun/bin:$HOME/.local/bin:$PATH"
cd "$SVC" || exit 1
mkdir -p logs
exec ./forge watchdog >> logs/watchdog.log 2>&1
