<?xml version="1.0" encoding="UTF-8"?>
<!-- The Forge daemon. This is a template: deploy/install.sh replaces __SVC__ with this repo's absolute path
     and installs the result into ~/Library/LaunchAgents/. Do not copy it there yourself.
     A LaunchAgent runs at the user level, so a logged-in session has the keychain and claude, codex and gh
     all work. RunAtLoad starts it at login.
     KeepAlive=true restarts the process whenever it exits; ThrottleInterval=30 keeps a crash loop from
     turning into a restart storm.
     ProgramArguments points straight at forge-daemon (which carries its own #!/bin/zsh), so background
     activity shows forge-daemon rather than zsh.
     Note that KeepAlive only rescues a process that exited, never one that wedged -- a wedged process is
     com.forge.watchdog's job (see the README in this directory). -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.forge.daemon</string>
  <key>ProgramArguments</key>
  <array>
    <string>__SVC__/deploy/forge-daemon</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__SVC__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__SVC__/logs/launchd.out</string>
  <key>StandardErrorPath</key>
  <string>__SVC__/logs/launchd.err</string>
</dict>
</plist>
