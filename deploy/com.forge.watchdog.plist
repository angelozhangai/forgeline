<?xml version="1.0" encoding="UTF-8"?>
<!-- The Forge watchdog. This is a template: deploy/install.sh replaces __SVC__. Every 60s it probes
     liveness, self-heals and alerts over IM, as a separate process watching the main daemon.
     StartInterval means run periodically rather than stay resident: every 60s it starts forge-watchdog,
     which runs once and exits.
     Why it is separate from the main daemon: a wedged or dead process cannot monitor itself, so the monitor
     has to live outside what it monitors.
     ProgramArguments points straight at forge-watchdog, so background activity shows forge-watchdog rather
     than zsh. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.forge.watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <string>__SVC__/deploy/forge-watchdog</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__SVC__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__SVC__/logs/watchdog.out</string>
  <key>StandardErrorPath</key>
  <string>__SVC__/logs/watchdog.err</string>
</dict>
</plist>
