# Forge 私有环境（复制为 config/forge.env；已 gitignore）。由 ./forge 自动载入。
# 换机时不要提交真实文件；密钥/状态走仓库外安全迁移。

# 目标项目仓根（默认 example-project）。留空 = 自动找兄弟目录 ../example-project（同在 workspace/ 下即可免填）。
FORGE_PROJECT_ROOT=

# 飞书结果卡片 webhook（dogfood 群「自定义机器人」的 webhook URL）；
# 留空则只用 feishu-doc.js 往 PRD 文档写评论，不发群卡片
FEISHU_REVIEW_WEBHOOK=
# 可选：webhook 签名密钥（群机器人开启签名校验时）
FEISHU_REVIEW_WEBHOOK_SECRET=

# dogfood 群 chat_id（V2 轮询入口用；V1 手动 add 可留空）
FEISHU_REVIEW_CHAT_ID=

# ── 飞书 bot 私聊通知（待确认/待GO/失败/完成 推到你私聊；后续按钮回调也走它）──
# 复用 lark-mcp 应用须先在飞书后台授 im:message:send（链接见 deploy/README.md）。未填则降级 webhook/本地桌面通知。
FEISHU_BOT_APP_ID=
FEISHU_BOT_APP_SECRET=
# bot 自身 open_id：群消息入口闸判「这条群消息有没有 @ 本机器人」用（群里未 @ 不入流程，避免随手分享被误吃成 PRD）。
# 缺省自动问 bot/v3/info 取（需 bot 在线）；想免一次请求/确定性可手填（飞书后台「凭证与基础信息」或 bot/v3/info）。
FEISHU_BOT_OPEN_ID=
FEISHU_DM_OPEN_ID=
# 或用 p2p 会话 id（open_id 优先）
FEISHU_DM_CHAT_ID=
# 关闭 macOS 本地桌面通知兜底：设 0
NOTIFY_DESKTOP=

# ── IM provider 选择（见 src/messaging/index.ts）──
# feishu（缺省，留空即可）| slack。**认不出的值会让服务直接起不来**——绝不静默回退，
# 否则拼错一个字母就变成「所有审批卡照发飞书、Slack 一片空白」，而且没有任何症状。
FORGE_MESSAGING_PROVIDER=

# ── Slack（仅当 FORGE_MESSAGING_PROVIDER=slack 时需要）──
# 后台 api.slack.com/apps → 建 App：
#   OAuth & Permissions → Bot Token Scopes: chat:write, channels:history, groups:history, im:write, users:read
#   Socket Mode → 打开，并在 Basic Information → App-Level Tokens 建一枚带 connections:write 的 token
#   Event Subscriptions → 订阅 message.channels / message.groups / message.im
#   Interactivity & Shortcuts → 打开（表单走 modal，必须开）
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# bot 自身 user id（后台 App → Basic Information，或 auth.test）。
# **不填等于哑火**：群消息无法判断有没有 @ 到本机器人 → 核心一律保守忽略。
SLACK_BOT_USER_ID=
# 私聊推送目标：你本人的 user id（Slack 允许直接把 user id 当 channel 发 DM）
SLACK_DM_USER_ID=
# 逗号分隔的 channel id：群入口 + 开机/重连离线补拉
SLACK_WATCH_CHANNELS=
# 可选：Incoming Webhook URL（bot 私聊未送达时的群侧降级）
SLACK_WEBHOOK_URL=

# 本机阶段：claude / codex 直接用各自 CLI 的已登录态，无需填。
# Mac mini 无人值守阶段再填（claude setup-token 生成的 1 年期 token）：
# CLAUDE_CODE_OAUTH_TOKEN=

# ── 保活/健康（本地状态页 + 看门狗）──
# 健康服务/状态页端口（仅绑 127.0.0.1）。留空 = 用 runtime.yaml › health.port（默认 4319）。
# FORGE_HEALTH_PORT=4319

# ── 控制面/Runner 分离（Phase 2，默认 all-in-one）──
# RUNNER 侧：设了 → 本进程是**纯 runner**，经 HTTP 从远端控制面拉 job（GET <url>/jobs）+ 读写状态（POST <url>/store）。
# 留空 = all-in-one（本地 DB 枚举/直连 sqlite，现状）。
# FORGE_CONTROL_URL=https://control.example/forge
# 控制面鉴权 shared secret：runner 带 `Authorization: Bearer <token>`，控制面 server 校验。两端须一致。
# FORGE_CONTROL_TOKEN=
#
# CONTROL 侧（控制面那台）：HTTP 面绑定地址/端口（默认 127.0.0.1:4320）。
# **配了 FORGE_CONTROL_PORT 的 `forge listen` 即「控制面进程」**：一个进程 = 编排 tick + 自身 job loop + 服务
# /jobs+/store 给额外 runner（单 sqlite 连接、无多进程争用）。额外 runner 在别的机器跑 `forge listen` 并设
# FORGE_CONTROL_URL 指向这台（纯 runner：只跑 job loop）。`forge control` 是只起 HTTP 面、不跑编排的独立变体。
# ⚠️ 绑非回环（对外）**必须**配 FORGE_CONTROL_TOKEN，否则 fail-closed 拒绝启动（/store 可读写全部 session 状态）。
# ⚠️ 控制面那台**不要**设 FORGE_CONTROL_URL（那是 runner 标记）——设了控制面 server 会 fail-closed 拒绝启动。
# FORGE_CONTROL_HOST=127.0.0.1
# FORGE_CONTROL_PORT=4320
#
# 多 runner 防重领（lease）：
# RUNNER 身份（lease owner）。留空 = host:pid。多 runner 各给不同值更可读（也便于审计谁领了哪条）。
# FORGE_RUNNER_ID=
# 租约 TTL（秒，默认 7200=2h）：一个 runner 持有 job 不被别 runner 抢走的时长。**必须 ≥ 单 tick 处理一个 job 的
# 最长时间**，否则长 step 跑一半租约过期→另一 runner 重领→同 worktree 双跑。重下游（闸C/D 单 step 很久）调大。
# FORGE_LEASE_TTL_SEC=7200
