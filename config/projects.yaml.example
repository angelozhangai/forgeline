# The multi-project registry (optional). Copy it to config/projects.yaml to let one Forge serve several
# projects.
# Without this file there is a single default project: root finds the sibling ../example-project
# automatically and every setting comes from runtime.yaml -- exactly as it behaved before this existed.
# On a new machine it has to be rebuilt or rechecked against that machine's paths.
#
# How an incoming PRD is bound to a project, in order of precedence: an explicit
# `forge add --project <id>`, then the chat-to-project mapping in `chats`, then default_project.
# Any field an entry omits falls back: repos, branches, default_branch and tech_design_publish all fall back
# to runtime.yaml.
# repoMap and umbrella fall back to the demo defaults ({C:demo, U:example-web, A:example-admin,
#   E:example-engine} and example-project) for the **default project only**. A **non-default project inherits
#   neither**: its repoMap defaults to {} (a project using letter codes for a multi-repo Epic has to supply
#   its own) and its umbrella defaults to its own repos[0].
# owner (the GitHub org) falls back to your-org, so a non-default project living in another org has to
# declare its owner explicitly.
# repos holds **local repo keys or paths** -- where the code is actually read from, with '.' for a monorepo --
# and is not the GitHub slug. When a local key differs from the GitHub repo name (the classic case being a
#   monorepo's '.'), repoSlugs has to map local key -> GitHub slug, or `gh -R owner/.` points at the wrong
#   repo. For demo the repo name is the slug, so nothing is needed.
# Prompts can be overridden per project: put prompts/<id>/<name>.md inside Forge to override the ones you
# need, and anything else falls back to the default prompts/<name>.md.

default_project: demo

projects:
  # The default project: leaving root empty finds the sibling ../example-project automatically, and every
  # setting falls back to runtime.yaml. All it needs to declare is its chats.
  demo:
    chats:
      - oc_xxxxxxxxxxxxxxxx        # a PRD posted in these chats belongs to the demo project

  # A second project, as an example -- uncomment it and change it to your own:
  # acme:
  #   root: /Users/you/workspace/acme-project      # the project's repo root (required for a non-default project)
  #   repos: [acme-web, acme-api]                   # the repos gate A reads the real code from
  #   branches: { prod: main, dev: dev }
  #   default_branch: dev
  #   tech_design_publish: { enabled: true, base: main }
  #   repoMap: { W: acme-web, A: acme-api }          # gate B's envelope letters -> repo names
  #   umbrella: acme-project                         # the repo the multi-repo Epic itself lives in
  #   chats:
  #     - oc_yyyyyyyyyyyyyyyy

  # your-monorepo -- the first target project for downstream gates C and D: a single Nx monorepo with pnpm
  # and Prisma, trunk-based onto main.
  # your-monorepo:
  #   root: /path/to/your-monorepo
  #   repos: [.]                                     # a monorepo: one repo, whose path is the project root
  #   branches: { prod: main, dev: main }            # trunk-based: the merge queue only ever lands on main
  #   default_branch: prod
  #   # The scripts the downstream mechanical actions delegate to, with paths relative to the project root.
  #   # A worktree always goes through wt.sh, which handles node_modules, .envrc and the secrets.
  #   scripts:                                       # all under your-monorepo's tools/scripts/, by convention
  #     worktree_add: ./tools/scripts/wt.sh          # wt.sh <path> [-b <branch>] [<commit-ish>]
  #     ci: ./tools/scripts/forge-ci.sh              # runs pnpm ci:local internally, never a bare nx run-many
  #     diff: ./tools/scripts/forge-diff.sh
  #     create_pr: ./tools/scripts/forge-create-pr.sh # gh pr create, and never an automatic merge
  #     checks: ./tools/scripts/forge-checks.sh
  #   chats:
  #     - oc_zzzzzzzzzzzzzzzz
