#!/bin/sh
# 提交前本地 CI 闸口：lint + typecheck + test:cov（含覆盖率下限闸）必须全绿，否则拒绝提交。
# 顶层规则见 CLAUDE.md「提交前必做：本地 CI 全绿」。
#
# 启用一次（本仓约定，每个 clone 各跑一次）：
#   git config core.hooksPath .githooks
# 临时绕过（仅限紧急，须在 PR 说明原因）：
#   git commit --no-verify
set -e

if [ ! -d node_modules ]; then
  echo "[pre-commit] 缺 node_modules，先 npm ci/npm install 再提交" >&2
  exit 1
fi

echo "[pre-commit] 本地 CI：npm run ci（lint + typecheck + test:cov）..."
npm run --silent ci
echo "[pre-commit] ✓ 本地 CI 全绿，放行提交"
