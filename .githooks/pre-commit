#!/bin/sh
# The local CI gate before a commit: lint + typecheck + test:cov, coverage floors included, all have to be
# green or the commit is refused.
# The top rule this enforces is in CLAUDE.md: local CI must be green before every commit.
#
# Enable it once per clone (this repo's convention):
#   git config core.hooksPath .githooks
# Bypassing it temporarily is for emergencies only, and the reason has to be stated in the PR:
#   git commit --no-verify
set -e

if [ ! -d node_modules ]; then
  echo "[pre-commit] node_modules is missing -- run npm ci or npm install before committing" >&2
  exit 1
fi

echo "[pre-commit] local CI: npm run ci (lint + typecheck + test:cov)..."
npm run --silent ci
echo "[pre-commit] ✓ local CI is green, letting the commit through"
