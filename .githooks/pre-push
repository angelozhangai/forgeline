#!/usr/bin/env bash
# 拒绝从本地直接推 main，以及对 main 的非快进（force）推送。
#
# 为什么本地还要拦一道：GitHub 上 main 已经有 ruleset（禁删/禁 force/必须走 PR/CI 必须绿），
# 但 bypass 名单里有 Repository admin —— 也就是**仓主直接 `git push origin main` 会静默成功**。
# 服务端那条 bypass 是留给「CI 挂死了、必须先修」这类紧急情况的，不是给肌肉记忆用的。
# 对单人仓来说，最该拦的恰恰就是自己那一下手快，所以拦在本地：
# 服务端留出口，本地防手滑，两边职责不同，缺一边都不对。
#
# 真要绕过（且你确实想清楚了）：FORGELINE_ALLOW_MAIN=1 git push origin main
# 强推另有开关，且没有合并写法 —— 必须两个都显式设，逼你多想一秒。
#
# stdin 每行：<local ref> <local sha> <remote ref> <remote sha>
set -euo pipefail

ZERO='0000000000000000000000000000000000000000'
blocked=0

# shellcheck disable=SC2034  # local_ref 是 git 传进来的固定四列之一，用不到但必须占位
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${remote_ref:-}" ] || continue
  [ "$remote_ref" = "refs/heads/main" ] || continue

  # 删远端 main
  if [ "$local_sha" = "$ZERO" ]; then
    printf '\n  ✗ 拒绝删除远端 main。\n\n' >&2
    blocked=1
    continue
  fi

  # 非快进：远端有你本地没有的提交，强推会让它们消失。
  if [ "$remote_sha" != "$ZERO" ] && ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
    if [ "${FORGELINE_ALLOW_FORCE_MAIN:-}" != "1" ]; then
      cat >&2 <<'EOF'

  ✗ 拒绝对 main 的非快进推送（force push）。

    远端 main 上有你本地没有的提交。这是一个公开仓，main 的历史是对外的：
    强推会改写已经被别人 clone、被 issue/PR 引用过的提交。

    正确做法：git fetch origin && git pull --ff-only

EOF
      blocked=1
      continue
    fi
    printf '\n  ! FORGELINE_ALLOW_FORCE_MAIN=1：放行对 main 的强推。\n\n' >&2
  fi

  if [ "${FORGELINE_ALLOW_MAIN:-}" != "1" ]; then
    cat >&2 <<'EOF'

  ✗ 不要从本地直接推 main。

    main 只通过合并 PR 前进 —— 那是 CI（lint + typecheck + test，含覆盖率下限与
    用例数地板）真正成为硬门的唯一时刻。直接推等于绕过自己设的闸。

    开新工作：
      git switch -c <类型>/<简短描述> origin/main

    推分支开 PR：
      git push -u origin <分支名> && gh pr create

EOF
    blocked=1
  fi
done

[ "$blocked" -eq 0 ] || exit 1
