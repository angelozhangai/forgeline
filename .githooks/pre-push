#!/usr/bin/env bash
# Refuse a direct push to main from a local checkout, and refuse any non-fast-forward (force) push to it.
#
# Why block it locally when the server already does: main on GitHub carries a ruleset (no deletion, no force,
# a PR required, CI required), but Repository admin is on its bypass list -- so **the repo owner running
# `git push origin main` succeeds silently**.
# That server-side bypass exists for emergencies like "CI is wedged and has to be fixed first", not for
# muscle memory.
# In a one-person repo the thing most worth catching is your own reflex, so it is caught locally:
# the server keeps the escape hatch, the local hook catches the slip. The two have different jobs, and
# neither is redundant.
#
# To bypass it deliberately, having thought it through: FORGELINE_ALLOW_MAIN=1 git push origin main
# A force push needs its own switch on top, and there is no combined form -- both have to be set explicitly,
# which buys you one more second of thought.
#
# Each line on stdin: <local ref> <local sha> <remote ref> <remote sha>
set -euo pipefail

ZERO='0000000000000000000000000000000000000000'
blocked=0

# shellcheck disable=SC2034  # local_ref is one of the four columns git always passes; unused, but it has to hold the position
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${remote_ref:-}" ] || continue
  [ "$remote_ref" = "refs/heads/main" ] || continue

  # Deleting the remote main
  if [ "$local_sha" = "$ZERO" ]; then
    printf '\n  ✗ refusing to delete the remote main.\n\n' >&2
    blocked=1
    continue
  fi

  # Non-fast-forward: the remote holds commits you do not, and a force push would make them disappear.
  if [ "$remote_sha" != "$ZERO" ] && ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
    if [ "${FORGELINE_ALLOW_FORCE_MAIN:-}" != "1" ]; then
      cat >&2 <<'EOF'

  ✗ refusing a non-fast-forward (force) push to main.

    The remote main holds commits yours does not. This is a public repository, and main's history is public
    with it: a force push rewrites commits other people have already cloned and that issues and PRs refer to.

    The right move: git fetch origin && git pull --ff-only

EOF
      blocked=1
      continue
    fi
    printf '\n  ! FORGELINE_ALLOW_FORCE_MAIN=1: allowing a force push to main.\n\n' >&2
  fi

  if [ "${FORGELINE_ALLOW_MAIN:-}" != "1" ]; then
    cat >&2 <<'EOF'

  ✗ do not push straight to main from a local checkout.

    main moves only by merging a PR -- that is the one moment CI (lint + typecheck + test, coverage floors
    and the test-count floor included) actually becomes a hard gate. Pushing straight past it is bypassing
    the gate you set yourself.

    To start something new:
      git switch -c <type>/<short-description> origin/main

    To push the branch and open a PR:
      git push -u origin <branch-name> && gh pr create

EOF
    blocked=1
  fi
done

[ "$blocked" -eq 0 ] || exit 1
