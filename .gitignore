# Dependencies, build output and runtime artefacts
node_modules/
dist/

# State and logs, which hold raw PRD text and LLM transcripts -- never committed
state/
logs/

# The private environment (FORGE_PROJECT_ROOT, the IM webhook and so on). Only *.env.example is committed;
# moving to another machine goes through a secure channel outside the repo.
config/forge.env
# The multi-project registry holds machine-absolute paths (root: /Users/...), so like forge.env it is never
# committed; only *.yaml.example is.
config/projects.yaml
# The weekly-load manual corrections are subjective per-person scores and are never committed; only
# *.tsv.example is.
config/weekly-overrides.tsv

# Noise
.DS_Store
*.log

# Isolated worktrees. One convention only: <repo>/.forge/worktrees/<key>, created by tools/wt.sh.
# Local to the machine, never committed -- and ignored *before* the first tree is created, or the
# whole checkout inside it reads as files waiting to be committed.
.forge/

# Worktrees from Claude Code's built-in convention. New trees all go to .forge/ (tools/wt.sh check
# fails on any that do not); this line stays as a backstop for ones that predate the rule.
.claude/worktrees/
# This machine's private settings -- the shared .claude/settings.json, hooks/ and skills/ are committed.
.claude/settings.local.json
